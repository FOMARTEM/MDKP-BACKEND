BEGIN;


CREATE TABLE IF NOT EXISTS public."Employee"
(
    id bigserial NOT NULL,
    "LastName" character varying(64) NOT NULL,
    "FirstName" character varying(64) NOT NULL,
    "MiddleName" character varying(64) NOT NULL,
    "Email" character varying(255) NOT NULL,
    "Phone" character varying(32) NOT NULL,
    "BirthDate" date NOT NULL,
    "PasswordHash" character varying(511) NOT NULL,
    "IsActive" boolean NOT NULL,
    "Position_ID" integer NOT NULL,
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS public."Position"
(
    id serial NOT NULL,
    "Name" character(63) NOT NULL,
    "Description" character varying(255) NOT NULL,
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS public."Task"
(
    id bigserial NOT NULL,
    "Title" character varying(127) NOT NULL,
    "Description" text NOT NULL,
    "CreateDate" date NOT NULL,
    "DeadlineDate" date NOT NULL,
    "ReadyDate" date,
    "Priority" integer NOT NULL,
    "CreatorId" bigint NOT NULL,
    "EditorID" bigint NOT NULL,
    "AuthorID" bigint NOT NULL,
    "StatusID" integer NOT NULL,
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS public."Status"
(
    id serial NOT NULL,
    "Name" character varying(15) NOT NULL,
    "Description" character varying(127) NOT NULL,
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS public."Material"
(
    id bigserial NOT NULL,
    "FileName" character varying(64) NOT NULL,
    "Extension" character varying(4) NOT NULL,
    "Description" text NOT NULL,
    "EmployeeID" bigint,
    "TaskID" bigint,
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS public."Version"
(
    id bigserial NOT NULL,
    "VersionNumber" integer NOT NULL,
    "CreationDate" date NOT NULL,
    "Title" character varying(127) NOT NULL,
    "Description" text NOT NULL,
    "EmployeeID" bigint NOT NULL,
    "MaterialID" bigint,
    "TaskID" bigint NOT NULL,
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS public."Revision"
(
    id bigserial NOT NULL,
    "Description" text NOT NULL,
    "CreationDate" date NOT NULL,
    "EmployeeID" bigint NOT NULL,
    "VersionID" bigint NOT NULL,
    "StatusID" integer NOT NULL,
    PRIMARY KEY (id)
);

ALTER TABLE IF EXISTS public."Employee"
    ADD CONSTRAINT "Position" FOREIGN KEY ("Position_ID")
    REFERENCES public."Position" (id) MATCH SIMPLE
    ON UPDATE NO ACTION
    ON DELETE NO ACTION
    NOT VALID;

COMMENT ON CONSTRAINT "Position" ON public."Employee"
    IS 'Связь для определения прав (Админ, редактор, автор, руководитель и тп)';



